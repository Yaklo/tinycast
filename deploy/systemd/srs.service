[Unit]
Description=SRS 6 流媒体服务（TinyCast 媒体层）
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/usr/local/srs
Environment=CANDIDATE=
ExecStart=/usr/local/srs/objs/srs -c conf/srs.conf
Restart=always
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
