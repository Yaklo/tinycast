[Unit]
Description=TinyCast 直播业务后端
Documentation=https://github.com/ai-yaklo/tinycast
After=network-online.target mediamtx.service
Wants=network-online.target

[Service]
Type=simple
User=tinycast
Group=tinycast
EnvironmentFile=-/etc/tinycast/tinycast.env
ExecStart=/usr/local/bin/tinycast
Restart=always
RestartSec=2
# 只需要读配置、写日志，其余文件系统一律只读
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/var/log/tinycast
StateDirectory=tinycast
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
