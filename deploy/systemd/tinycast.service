[Unit]
Description=TinyCast 直播业务后端
Documentation=https://github.com/Yaklo/tinycast
After=network-online.target mediamtx.service
Wants=network-online.target mediamtx.service

[Service]
Type=simple
User=tinycast
Group=tinycast
# 不要用 - 前缀：缺配置时会静默回落，导致 18856 没人监听、推流全部失败
EnvironmentFile=/etc/tinycast/tinycast.env
WorkingDirectory=/var/lib/tinycast
ExecStart=/usr/local/bin/tinycast
Restart=always
RestartSec=2
# 只需要读配置、写日志，其余文件系统一律只读
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# 自动创建 /var/log/tinycast 并设好属主，避免目录缺失导致 226/NAMESPACE
LogsDirectory=tinycast
StateDirectory=tinycast
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
