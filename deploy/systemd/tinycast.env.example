# 复制为 /etc/tinycast/tinycast.env 后按需修改
# 规则：KEY=VALUE，一行一个；值不需要引号；# 开头为注释

# ---- HTTP 服务 ----
HTTP_ADDR=:18855
# 仅供 MediaMTX 回调的内部端口：公网端口不再注册 /internal/ 路由。
# mediamtx.yml 的 authHTTPAddress 端口要同步改成 18856。
INTERNAL_ADDR=127.0.0.1:18856
# 对外访问地址（带域名与协议时填写），用于生成给浏览器的绝对地址
PUBLIC_BASE_URL=
# 允许提供 X-Forwarded-For 的反向代理网段；默认只信任本机反代
# TRUSTED_PROXIES=127.0.0.0/8,::1/128

# ---- 日志 ----
# 日志级别：debug / info / warn / error；默认只记录 error
LOG_LEVEL=error
# 终端（journald）级别：留空跟随 LOG_LEVEL；想看详细输出可设为 info 或 debug
LOG_CONSOLE_LEVEL=
LOG_FILE=/var/log/tinycast/tinycast.log
LOG_MAX_MB=16
LOG_KEEP=3

# ---- 房间生命周期 ----
# 断流后保留时长
ROOM_GRACE=5m
# 轮询 MediaMTX 路径状态的间隔
MONITOR_INTERVAL=1s
# 观看心跳超时（超过这个时间没心跳就认为观众离开）
VIEWER_TIMEOUT=30s
# 鉴权通过但一直没有真正推流成功的绑定，多久后释放
PENDING_TIMEOUT=60s

# ---- 与 MediaMTX 的对接 ----
# 推流 app 名（RTMP 地址里的 /live 段）
MEDIAMTX_APP=live
# 后端读取 MediaMTX 路径状态的 API
MEDIAMTX_API_URL=http://127.0.0.1:9997
# MediaMTX 开启 api 鉴权时才需要
# MEDIAMTX_API_USER=
# MEDIAMTX_API_PASSWORD=
# 回调共享密钥：填写后必须给 mediamtx.yml 的 authHTTPAddress 加上 ?secret=<同一个值>
# MEDIAMTX_AUTH_SECRET=
# 允许发起回调的来源网段；默认只允许本机，跨容器部署再按需放开
MEDIAMTX_AUTH_ALLOWED_CIDRS=127.0.0.0/8,::1/128
# 后端把浏览器请求反代到 MediaMTX 的播放端口
MEDIAMTX_HLS_PROXY_TARGET=http://127.0.0.1:8888
MEDIAMTX_WHEP_PROXY_TARGET=http://127.0.0.1:8889
# 展示给主播的 RTMP 服务器地址
MEDIAMTX_RTMP_PUBLIC_BASE=rtmp://127.0.0.1:1935/live

# ---- 跨域 ----
# 前后端同源时留空
# CORS_ALLOWED_ORIGINS=
