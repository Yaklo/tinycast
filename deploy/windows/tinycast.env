# TinyCast 运行配置（Windows）
#
# 用法：tinycast.exe -config tinycast.env   （start.cmd / start-all.cmd 已经这样调用）
# 规则：KEY=VALUE，# 开头为注释，行尾不要写注释，值不需要引号（需要时可用成对引号）。
#      已经存在的系统环境变量优先，文件只补齐缺省项。改完要重启 TinyCast 生效。

# ---- HTTP 服务 ----
# 监听地址，:18855 表示所有网卡；只允许本机访问可写 127.0.0.1:18855
HTTP_ADDR=:18855
# 对外访问地址，用于拼装返回给浏览器的绝对地址；留空表示按浏览器当前地址推断。
# 配了域名/HTTPS 后建议填写，例如 https://live.example.com
PUBLIC_BASE_URL=
# 允许提供 X-Forwarded-For 的反向代理网段；默认只信任本机反代
# TRUSTED_PROXIES=127.0.0.0/8,::1/128

# ---- 日志 ----
# 日志级别：debug / info / warn / error；默认只记录 error
LOG_LEVEL=error
# 控制台级别：留空跟随 LOG_LEVEL；想看详细输出可设为 info 或 debug
LOG_CONSOLE_LEVEL=
# 完整日志写入该文件（按大小滚动）；留空则不落盘。目录会自动创建。
LOG_FILE=logs\tinycast.log
LOG_MAX_MB=16
LOG_KEEP=3

# ---- 房间生命周期 ----
# 断流后把房间保留多久（需求规定 5 分钟）
ROOM_GRACE=5m
# 多久问一次 MediaMTX 现在有哪些推流在跑
MONITOR_INTERVAL=1s
# 观众心跳超时：超过这个时间没有心跳就当作已离开
VIEWER_TIMEOUT=30s
# 鉴权通过但一直没真正推流成功的身份，多久后释放
PENDING_TIMEOUT=60s

# ---- 与 MediaMTX 的对接 ----
# 推流 app 名（RTMP 地址里的 /live 段），要和 mediamtx.yml 的路径前缀一致
MEDIAMTX_APP=live
# 读取 MediaMTX 路径状态的 API（只监听本机）
MEDIAMTX_API_URL=http://127.0.0.1:9997
# MediaMTX 开启 api 鉴权时才需要
# MEDIAMTX_API_USER=
# MEDIAMTX_API_PASSWORD=
# 回调共享密钥：填写后必须同时给 mediamtx\mediamtx.yml 的 authHTTPAddress 加上 ?secret=<同一个值>
# MEDIAMTX_AUTH_SECRET=
# 允许发起回调的来源网段；公网地址一律拒绝
MEDIAMTX_AUTH_ALLOWED_CIDRS=127.0.0.0/8,::1/128
# 后端把浏览器的 /hls/ 与 /rtc/ 请求反代到 MediaMTX 的对应端口
MEDIAMTX_HLS_PROXY_TARGET=http://127.0.0.1:8888
MEDIAMTX_WHEP_PROXY_TARGET=http://127.0.0.1:8889
# 展示给主播的 RTMP 服务器地址。局域网观看要改成这台机器的 IP，例如 rtmp://192.168.1.10:1935/live
MEDIAMTX_RTMP_PUBLIC_BASE=rtmp://127.0.0.1:1935/live

# ---- 跨域 ----
# 前后端同源时留空；若前端单独部署，填写其来源，例如 https://live.example.com
# CORS_ALLOWED_ORIGINS=
