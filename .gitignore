# 本地 Go 工具链与构建缓存（由 scripts/dev-env.sh 建立）
.tools/

# Go 构建产物
/bin/
# 发布产物（tar.gz / zip / SHA256SUMS）
/dist/
*.exe
*.test
*.out

# 前端依赖与构建产物
node_modules/
web/node_modules/
web/dist/
internal/webui/dist/*
!internal/webui/dist/.gitkeep

# 本地环境变量与日志
.env
.env.local
*.log

# pnpm/npm 的本地配置（含本机绝对路径，不入库）
.npmrc

# 编辑器
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
