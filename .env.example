# 本地开发用的环境变量样例：先用 set -a 导出，再 source .env：
#   set -a; source .env; set +a
# 直接 source 不会导出变量，go run 读不到。
# Windows 生产包请改 deploy/windows/tinycast.env
# docker compose 会自动读取同目录的 .env：先 cp .env.example .env，再按需修改。

HTTP_ADDR=:18855
# 仅供 MediaMTX 回调的内部端口：设置后公网端口不再暴露 /internal/。
# 启用时 mediamtx.yml 的 authHTTPAddress 端口要同步改成 18856。
INTERNAL_ADDR=127.0.0.1:18856
# 对外地址，留空按浏览器地址推断（docker compose 也读这一项）
PUBLIC_BASE_URL=
# 允许提供 X-Forwarded-For 的反向代理网段；默认只信任本机反代
# 反代跑在别的容器/机器时按实际网段填写，例如 172.16.0.0/12
# TRUSTED_PROXIES=127.0.0.0/8,::1/128
# 日志级别：debug / info / warn / error；默认只记录 error
LOG_LEVEL=error
# 终端级别：留空跟随 LOG_LEVEL；想看详细输出可设为 info 或 debug
LOG_CONSOLE_LEVEL=

# 断流后保留 5 分钟（需求规定）
ROOM_GRACE=5m
MONITOR_INTERVAL=1s
VIEWER_TIMEOUT=30s
PENDING_TIMEOUT=60s

MEDIAMTX_APP=live
MEDIAMTX_API_URL=http://127.0.0.1:9997
MEDIAMTX_HLS_PROXY_TARGET=http://127.0.0.1:8888
MEDIAMTX_WHEP_PROXY_TARGET=http://127.0.0.1:8889
MEDIAMTX_RTMP_PUBLIC_BASE=rtmp://127.0.0.1:1935/live
# MediaMTX 开启 api 鉴权时才需要
# MEDIAMTX_API_USER=
# MEDIAMTX_API_PASSWORD=
# —— MediaMTX 回调共享密钥（docker compose 里必填）——
# 容器里的回调端口监听在 0.0.0.0:18856（容器网络中的 MediaMTX 要能访问），
# 没有密钥时同网段任何人都能伪造推流鉴权，所以 docker-compose.yml 用
# ${MEDIAMTX_AUTH_SECRET:?...} 做了 fail-fast：这一项缺失或为空时 compose 直接
# 报错退出，不会带着空密钥启动。生成方式（任选其一）：
#   openssl rand -hex 32
#   head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n'
# 直接生成并写进 .env（重复执行只保留最后一行，不会堆两行 secret）：
#   sed -i '/^MEDIAMTX_AUTH_SECRET=/d' .env \
#     && printf 'MEDIAMTX_AUTH_SECRET=%s\n' "$(openssl rand -hex 32)" >> .env
# 只用十六进制字符：& # % ? 空格 等会破坏回调 URL 里的 ?secret= 参数。
# 直接跑本机二进制（非 Docker）时可以留空：回调只监听 127.0.0.1:18856，
# 安全性由下面的来源网段白名单保证。
# MEDIAMTX_AUTH_SECRET=
# 允许发起回调的来源网段；默认只允许本机（127.0.0.0/8,::1/128）
# Docker 等跨容器部署按实际网段放开，例如：
# MEDIAMTX_AUTH_ALLOWED_CIDRS=127.0.0.0/8,::1/128,172.16.0.0/12
