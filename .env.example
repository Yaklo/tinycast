# 复制为 .env 后按部署环境修改（docker compose 会自动读取）
# 公网可访问的服务器 IP 或域名，浏览器通过它连接 WebRTC 媒体端口（UDP 8000）
SRS_CANDIDATE=127.0.0.1

# 展示给推流用户的两条地址
SRS_RTMP_PUBLIC_BASE=rtmp://localhost/live
SRS_WEBRTC_PUBLIC_BASE=webrtc://localhost/live

# 可选：SRS 回调共享密钥，设置后需同步修改 deploy/srs/srs.conf 的四个回调地址（?secret=xxx）
SRS_CALLBACK_SECRET=

ROOM_GRACE=5m
JANITOR_INTERVAL=15s
LOG_LEVEL=info
