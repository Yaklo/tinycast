# 本地开发用的环境变量样例：source .env 或直接复制到 shell 里
# Windows 生产包请改 deploy/windows/tinycast.env

HTTP_ADDR=:18855
# 终端只输出报错；改成 debug 后终端与日志文件都输出全部日志
LOG_LEVEL=info

# 断流后保留 5 分钟（需求规定）
ROOM_GRACE=5m
MONITOR_INTERVAL=1s
VIEWER_TIMEOUT=30s
PENDING_TIMEOUT=60s

MEDIAMTX_APP=live
MEDIAMTX_API_URL=http://127.0.0.1:9997
MEDIAMTX_HLS_PROXY_TARGET=http://127.0.0.1:8888
MEDIAMTX_WHEP_PROXY_TARGET=http://127.0.0.1:8889
MEDIAMTX_RTMP_PUBLIC_BASE=rtmp://127.0.0.1:1935/live
# MEDIAMTX_AUTH_SECRET=
# MEDIAMTX_AUTH_ALLOWED_CIDRS=127.0.0.0/8,::1/128,192.168.0.0/16
